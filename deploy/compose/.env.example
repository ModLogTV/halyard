# Copy to .env next to compose.yaml. Keep .env out of version control.

# Password of the bundled Postgres user "halyard".
POSTGRES_PASSWORD=change-me

# Session signing secret, at least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Public URL users open in the browser (behind your TLS proxy).
BETTER_AUTH_URL=https://flags.example.com

# Who may create accounts: invite (first user becomes admin, then invited emails only) or open.
AUTH_SIGNUP_MODE=invite

# Image tag to run: latest, a version like 0.1.0, or edge for the main branch.
HALYARD_VERSION=latest

# Host address and port to publish the app on. Keep 127.0.0.1 when a TLS proxy on the host
# forwards to the app; use 0.0.0.0 only to expose the plain HTTP port directly.
HALYARD_BIND=127.0.0.1
HALYARD_PORT=3000

# Reverse proxies (IPs or CIDRs, comma separated) whose forwarding headers carry the client IP,
# used for rate limiting. A proxy on the host reaches the container from the Docker gateway,
# typically 172.16.0.0/12.
TRUSTED_PROXIES=172.16.0.0/12

# Refuse webhook targets on private networks (recommended when webhooks only go to the internet).
WEBHOOK_BLOCK_PRIVATE_NETWORKS=false

# Optional bearer token protecting GET /metrics.
METRICS_TOKEN=
