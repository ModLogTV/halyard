{
  "name": "halyard",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted feature flags with a modern UI and OFREP support",
  "license": "MIT",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --filter @halyard/web dev",
    "build": "bun run --filter '*' build",
    "start": "bun run --filter @halyard/web start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "db:generate": "bun run --filter @halyard/web db:generate",
    "db:migrate": "bun run --filter @halyard/web db:migrate",
    "db:seed": "bun run --filter @halyard/web db:seed",
    "setup": "bun install && bun run db:migrate && bun run db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^5.9.3"
  }
}
