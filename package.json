{
  "name": "halyard",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted feature flags with a modern UI and OFREP support",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "turbo run dev --filter=@halyard/web",
    "build": "turbo run build",
    "start": "turbo run start --filter=@halyard/web",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "setup": "bun install && turbo run db:migrate db:seed --filter=@halyard/web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^5.9.3",
    "turbo": "^2.8.0"
  }
}
