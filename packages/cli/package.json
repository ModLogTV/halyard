{
  "name": "@modlogtv/halyard-cli",
  "version": "0.1.0",
  "description": "Command line interface for Halyard: generate TypeScript types from your flags, import and export projects.",
  "license": "MIT",
  "author": "modlog",
  "homepage": "https://github.com/ModLogTV/halyard/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ModLogTV/halyard.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ModLogTV/halyard/issues"
  },
  "type": "module",
  "bin": {
    "halyard": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "bun run src/cli.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modlogtv/halyard-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "feature-flags",
    "openfeature",
    "halyard",
    "cli",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  }
}
