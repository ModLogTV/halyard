{
  "name": "@halyard/cli",
  "version": "0.1.0",
  "description": "Command line interface for Halyard: generate TypeScript types from your flags, import and export projects.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "halyard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "bun run src/cli.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@halyard/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "feature-flags",
    "openfeature",
    "halyard",
    "cli",
    "typescript"
  ]
}
