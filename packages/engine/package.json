{
  "name": "@modlogtv/halyard-engine",
  "version": "0.0.0",
  "description": "Pure, dependency-free feature flag evaluation engine used by Halyard. Evaluate a flag configuration against an evaluation context and get a value with a reason.",
  "license": "MIT",
  "author": "modlog",
  "homepage": "https://github.com/ModLogTV/halyard/tree/main/packages/engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ModLogTV/halyard.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/ModLogTV/halyard/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "feature-flags",
    "openfeature",
    "ofrep",
    "evaluation"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
