# Postgres connection string. docker-compose.yml provides this database.
DATABASE_URL=postgresql://halyard:halyard@localhost:5432/halyard

# Public URL of the app, used by better-auth for cookies and redirects.
BETTER_AUTH_URL=http://localhost:3000

# Secret used to sign sessions (at least 32 characters). Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Port the production server listens on.
PORT=3000

# Who may create accounts. "invite": the first account becomes the instance admin, afterwards only
# email addresses with a pending project invitation can sign up (admins can always create users).
# "open": anybody who can reach the instance can sign up.
AUTH_SIGNUP_MODE=invite

# Reverse proxies (IPs or CIDRs, comma separated) whose X-Forwarded-For / X-Real-IP headers carry the
# client address used for rate limiting. Leave unset when clients connect directly.
# TRUSTED_PROXIES=10.0.0.0/8

# Set to "false" to skip running database migrations on startup.
RUN_MIGRATIONS_ON_STARTUP=true

# How long startup waits for Postgres to accept connections before giving up (milliseconds).
# DATABASE_CONNECT_TIMEOUT_MS=60000

# Set to "false" to disable the background workers (scheduler, webhooks, flushers) on this replica.
ENABLE_WORKERS=true

# Refuse webhook targets that resolve to loopback, private, link-local or CGNAT addresses.
# Recommended on multi-tenant instances; keep "false" when webhooks must reach internal services.
WEBHOOK_BLOCK_PRIVATE_NETWORKS=false

# Worker polling intervals in milliseconds (workers also wake up on change events).
# SCHEDULER_INTERVAL_MS=15000
# WEBHOOK_DISPATCH_INTERVAL_MS=10000

# Optional: Prometheus metrics endpoint protection. When set, GET /metrics requires
# the header "Authorization: Bearer <token>".
# METRICS_TOKEN=
